# Matriz local environment (ADR-007 decision 6). Copy this file to .env, which git ignores, and
# replace the values with your own. Every value here is fictitious. Write values unquoted.

# Database connection: required. Docker Compose also creates this user with this password.
MATRIZ_DB_URL=jdbc:postgresql://localhost:5432/matriz
# Added 2026-11-12, team delivery decision 18; previously no host-port setting.
# Compose host port only; keep the port in MATRIZ_DB_URL consistent.
MATRIZ_DB_PORT=5432
MATRIZ_DB_USER=matriz
MATRIZ_DB_PASSWORD=change-me-local-only

# Optional Compose application profile host port; bound to loopback.
MATRIZ_APP_PORT=18089

# Signing key of the access tokens (ADR-005): required. A Base64-encoded random key of at least
# 32 bytes; generate your own with: openssl rand -base64 32
# The value below is a placeholder that start-up rejects, so that no published key is ever used.
# Changing the key signs everyone out at the next start-up.
MATRIZ_JWT_SIGNING_KEY=replace-with-the-output-of-openssl-rand-base64-32

# Demonstration data (decision 10): true adds it once to this database, through a database
# migration at the next start-up; false or absent does not. The setting is fixed for each database:
# Choose before the first start-up; see "Configuration and first start" in README.md.
MATRIZ_DEMO_DATA=false

# Passwords of the demonstration accounts: required at every start-up while MATRIZ_DEMO_DATA=true.
# Choose your own: each needs at least 15 characters and at most 72 bytes in UTF-8 (ADR-005), or
# start-up stops. They are used only when the demonstration data is added; changing one later does
# not change the account.
MATRIZ_DEMO_PASSWORD_ANA=
MATRIZ_DEMO_PASSWORD_RUI=
MATRIZ_DEMO_PASSWORD_EVA=
MATRIZ_DEMO_PASSWORD_DANIEL=
